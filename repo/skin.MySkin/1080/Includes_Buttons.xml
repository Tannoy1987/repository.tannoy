<!--Dialog Button OK Cancel-->	
	<include name="DialogButtonOther">
        <height>60</height>
        <width>350</width>
    </include>
	<include name="OSDSmallButton">
		<definition>
			<control type="radiobutton" id="$PARAM[control_id]">
				<textureradioonfocus colordiffuse="lightgreen">$PARAM[texture]</textureradioonfocus>
				<textureradioonnofocus colordiffuse="lightgreen">$PARAM[texture]</textureradioonnofocus>
				<textureradioofffocus colordiffuse="white">$PARAM[texture]</textureradioofffocus>
				<textureradiooffnofocus>$PARAM[texture]</textureradiooffnofocus>
				<textureradioondisabled colordiffuse="disabled">$PARAM[texture]</textureradioondisabled>
				<textureradiooffdisabled colordiffuse="disabled">$PARAM[texture]</textureradiooffdisabled>
				<texturefocus colordiffuse="button_focus">osd/fullscreen/buttons/button-fo.png</texturefocus>
				<texturenofocus/>
				<width>18</width>
				<height>18</height>
				<radiowidth>18</radiowidth>
				<radioheight>18</radioheight>
				<radioposx>-1</radioposx>
				<radioposy>0</radioposy>
				<onclick>$PARAM[onclick]</onclick>
				<selected>$PARAM[selected]</selected>
				<visible>Player.Process(videohwdecoder)</visible>
				<visible>!Integer.IsEqual(System.GetInt(coreelec.amlogic.dolbyvision.mode),2) + ![String.IsEqual(Player.Process(video.source.hdr.type.raw),2) + String.Contains(Player.Process(amlogic.vs10.mode),Bypass)]</visible>
				<visible>$PARAM[visible]</visible>
				<font>Reg28</font>
			</control>
		</definition>
	</include>
		<include name="DefaultSettingButton">
		<param name="height">60</param>
		<param name="textoffsetx">40</param>
		<definition>
			<textoffsetx>$PARAM[textoffsetx]</textoffsetx>
			<top>0</top>
			<height>$PARAM[height]</height>
			<aligny>center</aligny>
			<invalidcolor>invalid</invalidcolor>
			<selectedcolor>selected</selectedcolor>
			<texturefocus border="16" colordiffuse="button_focus">boxes/box.png</texturefocus>
			<texturenofocus  border="10" colordiffuse="box">boxes/box.png</texturenofocus>
		</definition>
	</include>
