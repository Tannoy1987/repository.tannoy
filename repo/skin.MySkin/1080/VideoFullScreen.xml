<?xml version="1.0" encoding="utf-8"?>
<window>
	<defaultcontrol></defaultcontrol>
	<zorder>1</zorder>
 	<onload>SetProperty(ShowDVLogo, true, home)</onload>
    <onload>AlarmClock(dv_clear_timer, ClearProperty(ShowDVLogo, home), 00:05, silent)</onload>
	<controls> 
  		<control type="group" id="2">
			<visible>Skin.HasSetting(DV/HDRflags)</visible>
            <visible>String.IsEqual(Window(home).Property(ShowDVLogo), true)</visible>
            <animation effect="fade" delay="300" time="200">Visible</animation>
            <animation effect="fade" delay="200" time="150">Hidden</animation>
            <right>-4</right>
            <top>0</top>
			<height>108</height>
            <control type="image" id="2">
				<right>15</right>
                <top>6</top>
                <width min="80" max="177">auto</width>
                <height min="29" max="30">auto</height>
                <aspectratio>keep</aspectratio>
                <align>right</align>
                <texture>$VAR[HDR]</texture>
				<animation effect="slide" end="54,0" time="0" condition="String.IsEqual(VideoPlayer.HdrType,hdr10)">conditional</animation>
            </control>
            <control type="label" id="2">
                <description>DV Format</description>
                <label>$VAR[DVELVar]</label>
				<top>-30</top>
				<right>9</right>
                <width>200</width>
                <height>138</height>
                <aligny>center</aligny>
                <align>right</align>
                <font>reg18</font>
                <textcolor>button_focus</textcolor>
				<shadowcolor>black</shadowcolor>
            </control>
        </control>
       <control type="image" id="25">
            <texture>overlays/tv0.png</texture>
			<visible>Skin.HasSetting(crtvideos) + !System.AddonIsEnabled(service.coreelec.settings)</visible>
			<height>1080</height>
			<width>1920</width>	
        </control>
		<control type="image" id="26">
            <texture>overlays/tv2160v2.png</texture>
			<height>1080</height>
			<width>1920</width>	
			<visible>Skin.HasSetting(crtvideos) + System.AddonIsEnabled(service.coreelec.settings) + !String.IsEqual(VideoPlayer.VideoResolution,4k)</visible>
        </control>
       <control type="image" id="27">
            <texture>overlays/tv.png</texture>
			<height>1080</height>
			<width>1920</width>	
			<aspectratio>center</aspectratio>
			<visible>Skin.HasSetting(crtvideos) + System.AddonIsEnabled(service.coreelec.settings) + String.IsEqual(VideoPlayer.VideoResolution,4k)</visible>
        </control>
		<control type="group" id="0">
			<control type="label" id="10">
				<left>45</left>
				<top>15</top>
				<width>1770</width>
				<height>100</height>
				<label></label>
				
				<shadowcolor>black</shadowcolor>
			</control>
			<control type="label" id="11">
				<left>45</left>
				<top>45</top>
				<width>1770</width>
				<height>100</height>
				<label></label>
				
				<shadowcolor>black</shadowcolor>
			</control>
			<control type="label" id="12">
				<left>45</left>
				<top>75</top>
				<width>1770</width>
				<height>100</height>
				<label></label>
				
				<shadowcolor>black</shadowcolor>
			</control>
		</control>
		<control type="group" id="1">
			<depth>DepthOSD+</depth>
			<visible>Player.Caching + Integer.IsGreater(Player.CacheLevel,0)</visible>
			<animation effect="fade" delay="300" time="200">Visible</animation>
			<animation effect="fade" delay="200" time="150">Hidden</animation>
			<centerleft>50%</centerleft>
			<width>110</width>
			<centertop>50%</centertop>
			<height>110</height>
			<control type="image" id="1">
				<centerleft>50%</centerleft>
				<centertop>50%</centertop>
				<width>110</width>
				<height>110</height>
				<texture colordiffuse="BFFFFFFF">osd/buffer-bg.png</texture>
			</control>
			<control type="image" id="1">
				<centerleft>50%</centerleft>
				<centertop>50%</centertop>
				<width>92</width>
				<height>92</height>
				<texture>dialogs/extendedprogress/loading-back.png</texture>
			</control>
			<control type="image" id="1">
				<centerleft>50%</centerleft>
				<centertop>50%</centertop>
				<width>92</width>
				<height>92</height>
				<texture colordiffuse="button_focus">$INFO[Player.CacheLevel,dialogs/volume/buffering/p,.png]</texture>
			</control>
			<control type="label" id="1">
				<description>buffering value</description>
				<label>$INFO[Player.CacheLevel]</label>
				<centerleft>50%</centerleft>
				<centertop>50%</centertop>
				<width>200</width>
				<height>200</height>
				<aligny>center</aligny>
				<align>center</align>
				
			</control>
		</control>
	</controls>
</window>
