                <control type="image" id="32112">
                    <height>50%</height>
                    <left>0</left>
                    <right>0</right>
                    <aspectratio>keep</aspectratio>
                    <texture fallback="DefaultNoPreview.png">$VAR[ShiftThumbVar]</texture>
                    <animation effect="slide" end="160,0" time="0" condition="Container.Content(images) | Container.Content(none)">conditional</animation>
                    <animation effect="zoom" start="100" end="50" time="0" condition="Container.Content(images) | Container.Content(none)">conditional</animation>
                    <visible>!Container.Content(favourites)</visible>
                </control>
                <control type="image" id="32113">
                    <aspectratio>keep</aspectratio>
                    <texture fallback="DefaultNoPreview.png">$VAR[ShiftThumbVar]</texture>
                    <visible>Container.Content(favourites)</visible>
                </control>
                <control type="group">
                    <top>50%</top>
                    <bottom>0</bottom>
                    <control type="textbox">
                        <left>30</left>
                        <top>30</top>
                        <bottom>30</bottom>
                        <right>30</right>
                        <align>center</align>
                        <aligny>center</aligny>
                        <autoscroll time="3000" delay="5000" repeat="10000">true</autoscroll>
                        <label>$INFO[ListItem.Tagline,[I],[/I][CR][CR]]$INFO[ListItem.Plot][CR][CR]</label>
                        <shadowcolor>black</shadowcolor>
                    </control>
                </control>
                <control type="group">
                    <bottom>2%</bottom>
                    <include>mediaflags</include>
                </control>         
            </control>
        </control>
