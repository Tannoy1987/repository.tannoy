                    <animation effect="slide" end="0,138" time="0" condition="String.IsEmpty(ListItem.Plot)">conditional</animation>
                </control>
            </control>
            <control type="group">
                <top>0</top>
                <visible>![Container.Content() | Container.Content(addons)]</visible>
