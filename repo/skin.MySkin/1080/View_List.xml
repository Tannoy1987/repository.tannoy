    <include name="DefaultList">
		<definition> 
            <control type="list" id="50">  
                <viewtype label="List (50)">Panel</viewtype>              
                <width>100%</width>
                <left>8</left>
                <top>8</top>
                <bottom>8</bottom>
                <scrolltime tween="sine">150</scrolltime>
                <orientation>vertical</orientation>
                <pagecontrol>531</pagecontrol>
                <movement>6</movement>
                <focusposition>2</focusposition>
                <onleft>9000</onleft>
                <onright>531</onright>
                <onup>50</onup>
                <ondown>50</ondown>
                <visible>![Container.Content(favourites) | Container.Content(files) | Container.Content(videos) | Container.Content(none)]</visible>
		        <focusedlayout height="81.8" width="634">
		        	<include>DefaultFocus</include>		
		        </focusedlayout>
		        <itemlayout height="81.8" width="634">
		        	<include>DefaultNoFocus</include>	
		        </itemlayout>
            </control>
            <control type="list" id="55">  
                <viewtype label="WideList (55)">Panel</viewtype>              
                <width>100%</width>
                <left>8</left>
                <top>8</top>
                <bottom>8</bottom>
                <scrolltime tween="sine">150</scrolltime>
                <orientation>vertical</orientation>
                <pagecontrol>531</pagecontrol>
                <movement>6</movement>
                <focusposition>2</focusposition>
                <onleft>9000</onleft>
                <onright>531</onright>
                <onup>55</onup>
                <ondown>55</ondown>
		        <focusedlayout height="81.8" width="1270">
                     <control type="group">
		        	<include>DefaultFocus</include>	
                </control>	
		        </focusedlayout>
		        <itemlayout height="81.8" width="1270">
		        	<include>DefaultNoFocus</include>	
		        </itemlayout>
            </control>
        </definition>
    </include>
     <include name="PVRList">
        <control type="group">
            <left>0</left>
            <top>0</top>
            <width>100%</width>
            <bottom>0</bottom>
                <control type="list" id="65"><!--groups-->  
                <animation type="conditional" condition="!Control.HasFocus(65)">
                    <effect type="slide" start="0" end="-644" time="400" tween="cubic" easing="out" />
                </animation>
                <width>33.5%</width>
                <left>1</left>
                <top>1</top> 	
                <height>1080</height>							   
                <focusposition>0</focusposition>
                <onleft>50</onleft>
                <onright>66</onright>
                <onup>65</onup>
                <ondown>65</ondown>
                <onback>50</onback>
                <orientation>vertical</orientation>
                <scrolltime>200</scrolltime>
                <itemlayout height="57.1">
                    <include>backbox</include>					
                    <control type="label">
                        <left>35</left>
                        <right>40</right>
                        <aligny>center</aligny>
                        <label>$INFO[ListItem.Label]</label>
                        <textcolor>white</textcolor>
                    </control>
                </itemlayout>
                <focusedlayout height="57.1">      <!--focuschannel groupbackground-->
                    <include>focusbox</include>
                    <control type="label">
                        <left>35</left>
                        <aligny>center</aligny>
                        <scroll>true</scroll>
                        <label>$INFO[ListItem.Label]</label>
                         <textcolor>black</textcolor>
                    </control>
                </focusedlayout>
                <content target="tvchannels" browse="auto" sortorder="descending">pvr://channels/tv/</content>
            </control>
            <control type="list" id="66"><!--lastplayed-->  
                <animation type="conditional" condition="!Control.HasFocus(66)">
                    <effect type="slide" start="0" end="-644" time="400" tween="cubic" easing="out" />
                </animation>
                <width>33.5%</width>
                <left>1</left>
                <top>1</top> 	
                <height>1080</height>							   
                <focusposition>0</focusposition>
                <onleft>65</onleft>
                <onright>531</onright>
                <onup>66</onup>
                <ondown>66</ondown>
                <onback>50</onback>
                <orientation>vertical</orientation>
                <scrolltime>200</scrolltime>	
                <itemlayout height="51.25">
                    	 <include>backbox</include>						
                    <control type="label">
                        <left>35</left>
                        <right>40</right>
                        <aligny>center</aligny>
                        <label>$INFO[ListItem.Label]</label>
                        <textcolor>white</textcolor>
                    </control>
                </itemlayout>
                <focusedlayout height="51.25">      <!--focuschannel groupbackground-->
 <include>focusbox</include>
                    <control type="label">
                        <left>35</left>
                        <aligny>center</aligny>
                        <scroll>true</scroll>
                        <label>$INFO[ListItem.Label]</label>
                        <textcolor>black</textcolor>
                    </control>
                </focusedlayout>
                <content target="tvchannels" browse="auto" sortby="lastplayed" sortorder="descending">pvr://channels/tv/*?view=lastplayed</content>
            </control>
        </control>  
    </include>
</includes>