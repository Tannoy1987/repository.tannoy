<?xml version="1.0" encoding="utf-8"?>
<window>
	<defaultcontrol always="true">9000</defaultcontrol>
	<onload>SetProperty(infobackground,$ESCINFO[ListItem.Art(fanart)],home)</onload>
	<onunload>ClearProperty(infobackground,home)</onunload>
	<controls> 
		<control type="image">
			<texture>colors/musicinfo.png</texture>
		</control>
		<control type="image">
			<left>633</left>
			<top>0</top>
			<right>0</right>
			<height>1080</height>
			<texture colordiffuse="ff1d1d1d">colors/white.png</texture>
			<visible>String.IsEmpty(ListItem.Art(fanart))</visible>
		</control>
		<control type="image">
			<left>633</left>
			<top>0</top>
			<right>0</right>
			<height>1080</height>
			<aspectratio aligny="top">scale</aspectratio>
			<texture colordiffuse="e01d1d1d">$INFO[ListItem.Art(fanart)]</texture>
		</control>
		<control type="label">
		  <width>1240</width>
		  <left>662</left>
		  <top>34</top>
		  <height>74</height>
		  <font>Reg75</font>
		  <label>$INFO[ListItem.Artist]</label>
		  <textcolor>$VAR[Artist/AlbumBF]</textcolor>
		  <visible>Container.Content(albums) + [Control.HasFocus(50) | Control.HasFocus(9334)]</visible>
	    </control>				
	    <control type="label">
		  	<left>662</left>
		  	<width>1150</width>
		  	<top>123</top>
		  	<height>49</height>
		  	<font>Reg50</font>
		  	<label>$INFO[ListItem.Title]</label>
		  	<textcolor>button_focus</textcolor>
		  	<visible>Container.Content(albums) + [Control.HasFocus(50) | Control.HasFocus(9334)]</visible>
	  	</control>	
		<control type="group">
			<bottom>0</bottom>
			<height>1080</height>
			<left>0</left>
			<width>632</width>	
			<control type="image">
				<right>0</right>
				<top>0</top>
				<bottom>0</bottom>
			    <texture>$INFO[ListItem.Art(fanart)]</texture>
			    <aspectratio>scale</aspectratio>
				<visible>!String.IsEmpty(ListItem.Art(fanart))</visible>
				<animation effect="fade"
					start="100" end="0" time="300" condition="Control.HasFocus(50) | Control.HasFocus(9334)">Conditonal</animation>
			</control>			
			<control type="image">
				<right>0</right>
				<top>0</top>
				<bottom>0</bottom>
			    <texture>$VAR[MusicInfoThumbVar]</texture>
			    <aspectratio>keep</aspectratio>
				<visible>String.IsEmpty(ListItem.Art(fanart))</visible>
				<animation effect="fade"
					start="100" end="0" time="300" condition="Control.HasFocus(50) | Control.HasFocus(9334)">Conditonal</animation>
			</control>			
	
			<control type="group">
				<visible>[Control.HasFocus(50) | Control.HasFocus(9334)] + Container.Content(albums)</visible>
				<control type="image">
				    <top>56</top>
				    <left>56</left>
				    <width>520</width>
				    <height>520</height>
				    <texture diffuse="diffuse/cd.png" fallback="$VAR[cd_color_location]">$INFO[ListItem.Art(discart)]</texture>
				    <aspectratio>keep</aspectratio>
				    <animation effect="slide"
						start="0,1080" end="0,-28" time="600" condition="true">WindowOpen</animation>
				</control>
				<control type="image">
				    <top>56</top>
				    <left>56</left>
				    <width>520</width>
				    <height>520</height>
				    <texture>$VAR[MusicInfoThumbVar]</texture>
				    <aspectratio>keep</aspectratio>
				    <animation effect="slide"
						start="0,1080" end="0,514" time="600" condition="true">WindowOpen</animation>
				</control>
			</control>
				<control type="group">
				<visible>Container.Content(artists) + Control.HasFocus(50)</visible>
				<control type="image">
				    <top>115</top>
				    <left>35</left>
				    <right>35</right>
				    <bottom>685</bottom>
				    <texture>$INFO[ListItem.Art(clearlogo)]</texture>
				    <aspectratio>keep</aspectratio>
				</control>
				<control type="image">
				    <top>400</top>
				    <left>-20</left>
				    <right>0</right>
				    <bottom>-25</bottom>
				    <texture>$INFO[ListItem.Art(cutout)]</texture>
				    <aspectratio>keep</aspectratio>
				</control>
			</control>

		</control>	
		<control type="group">
			<visible>ControlGroup(9000).HasFocus()</visible>	
			<control type="image">
				<width>80</width>
				<height>80</height>
				<right>0</right>
				<centertop>50%</centertop>
				<texture>$VAR[Album/Tracklist]</texture>
			</control>
			<control type="image">
				<width>30</width>
				<height>50</height>
				<right>25</right>
				<top>460</top>
				<texture colordiffuse="button_focus">buttons/spinctrl/arrow-light-up.png</texture>
				<visible>Container.Content(artists) | Container.Content(albums)</visible>
			</control>
		</control>
		<control type="group">
			<animation effect="slide" end="0,1080" time="0" condition="[Container.Content(artists) | Container.Content(albums) | Container.Content(songs)] + !Control.HasFocus(50) + !Control.HasFocus(9334)">conditional</animation>
			<include>fullpanelright</include>
			<control type="button" id="9334">
				<visible>Container.Content(albums)</visible>
				<top>115</top>
				<right>17</right>
				<width>60</width>
				<height>60</height>
				<font>font16</font>
				<textcolor>button_focus</textcolor>
				<texturefocus colordiffuse="button_focus">osd/bingie/play_fo.png</texturefocus>
				<texturenofocus>osd/bingie/play_fo.png</texturenofocus>
				<onclick condition="System.HasAddon(script.playalbum)">RunScript(script.playalbum,albumid=$INFO[ListItem.DBID]&amp;tracknr=$INFO[Container(50).ListItem.TrackNumber])</onclick>
				<onclick condition="!System.HasAddon(script.playalbum)">Notification(Play Album script missing,Please install script.playalbum,5000)</onclick>
				<onleft>50</onleft>
				<ondown>50</ondown>
				<onback>50</onback>
			</control>
			<control type="panel" id="50">
				<visible>![Container.Content(songs) | Container.Content(artists)]</visible>
				<left>-11</left>
				<top>192</top>
				<right>12</right>
				<bottom>55</bottom>
				<onback>9000</onback>
				<onright>9334</onright>
				<orientation>vertical</orientation>
				<itemlayout height="90" width="1265">
					<control type="group">
						<left>10</left>
    					<include content="bg">
    					    <param name="bs" value="5" />
    					</include>
						<control type="label">
							<left>20</left>
							<top>0</top>
							<right>20</right>
							<height>90</height>
							<font>font16</font>
							<align>left</align>
							<aligny>center</aligny>
							<label>$INFO[ListItem.TrackNumber]  -  $INFO[ListItem.Label]</label>
						</control>
					</control>
				</itemlayout>
				<focusedlayout height="90" width="1265">
					<control type="group">
						<left>10</left>
						<include>focusbox</include>
						<control type="label">
							<left>20</left>
							<top>0</top>
							<right>20</right>
							<height>90</height>
							<font>font16</font>
							<align>left</align>
							<aligny>center</aligny>
							<textcolor>black</textcolor>
							<label>$INFO[ListItem.TrackNumber]  -  $INFO[ListItem.Label]</label>
						</control>
					</control>
				</focusedlayout>
			</control>
			<control type="panel" id="50">
				<visible>![Container.Content(songs) | Container.Content(albums)]</visible>
				<left>24</left>
				<top>2</top>
				<right>0</right>
				<bottom>5</bottom>
				<onback>9000</onback>
				<orientation>vertical</orientation>
				<itemlayout height="350" width="300">
					<control type="group">	
						<control type="image">
							<bordersize>10,-5,10,50</bordersize>
							<texture fallback="DefaultAudio.png" background="true">$INFO[ListItem.Thumb]</texture>
							<aspectratio>keep</aspectratio>
						</control>
						<control type="image">
							<bordersize>4,4,4,59</bordersize>
							<texture colordiffuse="border_alpha">boxes/borderinnerboxcircle2.png</texture>
						</control>
						<control type="textbox">
							<bottom>0</bottom>
							<height>60</height>
							<left>10</left>
							<right>10</right>
							<font>font10</font>
							<align>center</align>
							<aligny>center</aligny>
							<label>$INFO[ListItem.Label2,[COLOR button_focus], - [/COLOR]]$INFO[ListItem.Label]</label>
							<visible>Control.HasFocus(50)</visible>
						</control>
					</control>		
				</itemlayout>
				<focusedlayout height="350" width="300">
					<control type="group">
						<left>-2</left>
						<control type="image">
							<bordersize>10,-5,10,50</bordersize>
							<texture fallback="DefaultAudio.png" background="true">$INFO[ListItem.Thumb]</texture>
							<aspectratio>keep</aspectratio>
						</control>
						<control type="image">
							<bordersize>4,2,4,57</bordersize>
							<texture colordiffuse="button_focus">boxes/borderinnerboxcircle2.png</texture>
						</control>
						<control type="textbox">
							<bottom>0</bottom>
							<height>60</height>
							<left>10</left>
							<right>10</right>
							<font>font10</font>
							<align>center</align>
							<aligny>center</aligny>
							<label>$INFO[ListItem.Label2,[COLOR button_focus], - [/COLOR]]$INFO[ListItem.Label]</label>
							<autoscroll delay="1000" time="1000" repeat="1000">true</autoscroll>
						</control>
					</control>
				</focusedlayout>
			</control>
		</control>
		<include>MusicInfo</include>
		<include>crt</include>
	<!-- 	<include>Content</include>
			 <include>Lineoverlay</include>  -->

	</controls>
</window>