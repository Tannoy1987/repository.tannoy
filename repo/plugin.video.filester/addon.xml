<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.filester" name="Filester" version="1.0.1" provider-name="Tannoy">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="main.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Filester Kodi Addon</summary>
        <description lang="en_GB">Stream files from Filester using an API key.</description>
        <platform>all</platform>
        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>
</addon>