msgctxt "#30000"
msgid "Filester"
msgstr "Filester"

msgctxt "#30001"
msgid "Filester Settings"
msgstr "Filester Settings"

msgctxt "#30002"
msgid "API Key"
msgstr "API Key"

msgctxt "#30003"
msgid "Your Filester API key. Sent as Authorization: Bearer on every request. Get it from your Filester account."
msgstr "Your Filester API key. Sent as Authorization: Bearer on every request. Get it from your Filester account."

msgctxt "#30004"
msgid "Items per page"
msgstr "Items per page"

msgctxt "#30005"
msgid "API max is 100. Lower values load faster; higher values need fewer page turns."
msgstr "API max is 100. Lower values load faster; higher values need fewer page turns."

msgctxt "#30006"
msgid "Default sort"
msgstr "Default sort"

msgctxt "#30007"
msgid "Filester API has no sort parameter, so sorting is done inside the addon."
msgstr "Filester API has no sort parameter, so sorting is done inside the addon."

msgctxt "#30008"
msgid "Fetch all pages for correct sorting"
msgstr "Fetch all pages for correct sorting"

msgctxt "#30009"
msgid "ON: loads every page then sorts (correct order, slower on huge folders). OFF: sorts only the current page (fast, order may be wrong across pages)."
msgstr "ON: loads every page then sorts (correct order, slower on huge folders). OFF: sorts only the current page (fast, order may be wrong across pages)."

msgctxt "#30010"
msgid "Folder listing method"
msgstr "Folder listing method"

msgctxt "#30011"
msgid "'files-filter' uses GET /files?folder= (pagination works). 'folder-files' uses GET /folder/id/files (has the page-parameter bug; addon dedupes by id)."
msgstr "'files-filter' uses GET /files?folder= (pagination works). 'folder-files' uses GET /folder/id/files (has the page-parameter bug; addon dedupes by id)."

msgctxt "#30012"
msgid "CDN cache-buster"
msgstr "CDN cache-buster"

msgctxt "#30013"
msgid "Append _t=timestamp plus no-cache headers like the Filester web UI, so refreshes never show stale listings."
msgstr "Append _t=timestamp plus no-cache headers like the Filester web UI, so refreshes never show stale listings."

msgctxt "#30014"
msgid "Verify SSL certificates"
msgstr "Verify SSL certificates"

msgctxt "#30015"
msgid "Keep ON normally. The u1.filester.me certificate expired in Oct 2026; if you see CERTIFICATE_VERIFY_FAILED, either keep this ON (addon auto-retries unverified once) or turn it OFF."
msgstr "Keep ON normally. The u1.filester.me certificate expired in Oct 2026; if you see CERTIFICATE_VERIFY_FAILED, either keep this ON (addon auto-retries unverified once) or turn it OFF."

msgctxt "#30016"
msgid "Auto-retry past expired certificate"
msgstr "Auto-retry past expired certificate"

msgctxt "#30017"
msgid "If a request fails with CERTIFICATE_VERIFY_FAILED, retry it once without verification. Turn back off once Filester renews their certificate."
msgstr "If a request fails with CERTIFICATE_VERIFY_FAILED, retry it once without verification. Turn back off once Filester renews their certificate."

msgctxt "#30018"
msgid "Show folder thumbnails"
msgstr "Show folder thumbnails"

msgctxt "#30019"
msgid "Fetch each folder's public page og:image (the only public way to get auto-generated folder art). Adds one small request per folder; timeouts/5xx are treated as transient, missing og:image means no thumbnail."
msgstr "Fetch each folder's public page og:image (the only public way to get auto-generated folder art). Adds one small request per folder; timeouts/5xx are treated as transient, missing og:image means no thumbnail."

msgctxt "#30020"
msgid "Confirm before delete"
msgstr "Confirm before delete"

msgctxt "#30021"
msgid "Show a Yes/No dialog before deleting any file or folder."
msgstr "Show a Yes/No dialog before deleting any file or folder."

