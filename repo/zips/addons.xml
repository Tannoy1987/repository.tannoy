<?xml version='1.0' encoding='utf-8'?>
<addons><addon id="plugin.video.filester" name="Filester" version="1.0.1" provider-name="Tannoy">
    <requires>
        <import addon="xbmc.python" version="3.0.0" />
    </requires>
    <extension point="xbmc.python.pluginsource" library="main.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">Filester Kodi Addon</summary>
        <description lang="en_GB">Stream files from Filester using an API key.</description>
        <platform>all</platform>
        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>
</addon><addon id="repository.tannoy1987" name="Tannoy Kodi Repository" version="1.0.3" provider-name="Tannoy">
    <extension point="xbmc.addon.repository" name="Tannoy Kodi Repository">
        <dir>
            <info compressed="false">https://tannoy1987.github.io/repository.tannoy/repo/zips/addons.xml</info>
            <checksum>https://tannoy1987.github.io/repository.tannoy/repo/zips/addons.xml.md5</checksum>
            <datadir zip="true">https://tannoy1987.github.io/repository.tannoy/repo/zips/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary>Tannoy1987 Kodi Repository</summary>
        <description>Kodi repository hosting my skins and addons.</description>
        <disclaimer />
        <platform>all</platform>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon><addon id="service.discart" name="DiscArt Service" version="1.0.3" provider-name="Tannoy">
    <requires>
        <import addon="xbmc.python" version="3.0.0" />
    </requires>
    <extension point="xbmc.service" library="service.py" start="login" />
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">DiscArt Service</summary>
        <description lang="en_GB">Provides discart support.</description>
        <platform>all</platform>
        <license>GPL-2.0-only</license>
        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>
</addon><addon id="skin.MySkin" version="0.4.95" name="MySkin" provider-name="Tannoy">
	<requires>
		<import addon="xbmc.gui" version="5.17.0" />
		<import addon="xbmc.python" version="3.0.0" />
		<import addon="script.playalbum" version="4.0.2" />
		<import addon="service.discart" version="1.0.3" />
	</requires>
	<extension point="xbmc.gui.skin" debugging="false">
		<res width="1920" height="1080" aspect="16:9" default="true" folder="1080" />
	</extension>
	<extension point="xbmc.addon.metadata">
		<platform>all</platform>
		<license>CC BY-SA 4.0, GNU GENERAL PUBLIC LICENSE Version 2.0</license>
		<assets>
			<icon>resources/icon.png</icon>
			<fanart>resources/fanart.jpg</fanart>
			<screenshot>resources/screenshot-01.jpg</screenshot>
			<screenshot>resources/screenshot-02.jpg</screenshot>
			<screenshot>resources/screenshot-03.jpg</screenshot>
			<screenshot>resources/screenshot-04.jpg</screenshot>
			<screenshot>resources/screenshot-05.jpg</screenshot>
			<screenshot>resources/screenshot-06.jpg</screenshot>
			<screenshot>resources/screenshot-07.jpg</screenshot>
			<screenshot>resources/screenshot-08.jpg</screenshot>
		</assets>
		<summary lang="en_GB">MySkin — a custom Kodi skin by Tannoy</summary>
		<description lang="en_GB">A custom Kodi skin with a modern look.</description>
		<disclaimer lang="en_GB" />
	</extension>
</addon></addons>